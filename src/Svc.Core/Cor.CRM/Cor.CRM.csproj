<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- API Versioning -->
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="AutoMapper" />

    <!-- AutoMapper - REMOVED DUPLICATE -->
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" />

    <!-- Dapper & MediatR -->
    <PackageReference Include="Dapper" />
    <PackageReference Include="MediatR" />

    <!-- Ethiopian Calendar -->
    <PackageReference Include="EthiopianCalendar" />

    <!-- gRPC -->
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.ResponseCaching" />

    <!-- Entity Framework -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.OpenApi" />

    <!-- PostgreSQL -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!-- ? REMOVED: Microsoft.Extensions.Hosting (not needed in this project) -->
    <!-- ? REMOVED: Microsoft.Extensions.Caching.Memory (not needed) -->
    <!-- ? REMOVED: Microsoft.Extensions.Diagnostics.HealthChecks (not needed directly) -->

    <!-- Caching - Keep only if used -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />

    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" />

    <!-- HTTP Resilience -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />

    <!-- RabbitMQ -->
    <PackageReference Include="RabbitMQ.Client" />

    <!-- Scalar & Swagger -->
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />

    <!-- Serilog -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\gRPC\Common\Common.csproj" />
    <ProjectReference Include="..\..\RST_ERP.ServiceDefaults\RST_ERP.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Shared\Helpers\Helpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="@(Content)">
      <Visible Condition="'%(NuGetItemType)' == 'Content'">false</Visible>
    </Content>
  </ItemGroup>
 </Project>