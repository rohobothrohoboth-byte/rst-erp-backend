{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AuditLog": {
    "Enabled": true,
    "BatchSize": 200,
    "FlushIntervalSeconds": 10
  }
}