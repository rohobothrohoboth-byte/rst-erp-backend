{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AuditLog": {
    "Enabled": true,
    "BatchSize": 200,
    "FlushIntervalSeconds": 10
  },
  "Redis": {
    "ConnectionString": "redis-cluster:6379,password=${REDIS_PASSWORD},ssl=true,abortConnect=false"
  }
}