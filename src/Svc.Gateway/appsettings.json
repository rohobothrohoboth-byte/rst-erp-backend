{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AuthUrl": "http://{ServiceHost}:7000",
  "AllowedHosts": "*",
  "ServiceHost": "192.168.1.2",
