{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServiceUrl": "http://localhost:1213",
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "sharedCluster": {
        "ClusterId": "Shared",
        //"AuthorizationPolicy": "default",
        "Match": {
          "Path": "/shared/{**catch-all}",
          "Methods": ["GET"]
        },
        "Transforms": [{"PathPattern": "api/shared/{**catch-all}"}]
      },
      "coreCluster": {
        "ClusterId": "Core",
        //"AuthorizationPolicy": "default",
        "Match": {
          "Path": "/core/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE" ]
        },
        "Transforms": [{"PathPattern": "api/core/{**catch-all}"}]
      }
    },
    "Clusters": {
      "Shared": {
        "Destinations": {
          "sharedApi": {
            "Address": "https://localhost:1200"
          }
        }
      },
      "Core": {
        "Destinations": {
          "coreApi": {
            "Address": "https://localhost:1214"
          }
        }
      }
    }
  }
}