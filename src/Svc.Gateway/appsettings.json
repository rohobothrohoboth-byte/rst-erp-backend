          "Path": "/auth/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [
          { "PathPattern": "api/auth/{**catch-all}" },
          { "ResponseHeader": "X-Forwarded-Url", "Set": "{@requestScheme}://{@requestHost}{@requestPath}" }
        ]
      },
