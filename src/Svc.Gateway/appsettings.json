{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServiceUrl": "http://localhost:1213",
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "coreRead": {
        "ClusterId": "Core",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/core/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE" ]
        },
        "Transforms": [
          {
            "PathPattern": "api/core/{**catch-all}"
          }
        ]
      }
      //"notifications": {
      //  "ClusterId": "notifications",
      //  "CorsPolicy": "customPolicy",
      //  "Match": {
      //    "Path": "/notifications/{**catch-all}"
      //  }
      //}
    },
    "Clusters": {
      "Core": {
        "Destinations": {
          "coreApi": {
            "Address": "https://localhost:1214"
          }
        }
      }
      //"search": {
