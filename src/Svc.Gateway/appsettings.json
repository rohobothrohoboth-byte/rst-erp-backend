{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServiceUrl": "http://localhost:1213",
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "lupCluster": {
        "ClusterId": "Lup",
        //"AuthorizationPolicy": "default",
        "Match": {
          "Path": "/lup/{**catch-all}",
          "Methods": ["GET"]
        },
        "Transforms": [{"PathPattern": "api/lup/{**catch-all}"}]
      },
      "coreHRMMCluster": {
        "ClusterId": "coreHRMM",
        //"AuthorizationPolicy": "default",
        "Match": {
          "Path": "/core/hrmm/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE" ]
        },
        "Transforms": [{"PathPattern": "api/core/hrmm/{**catch-all}"}]
      },
      "coreModuleCluster": {
        "ClusterId": "CoreModule",
        //"AuthorizationPolicy": "default",
        "Match": {
          "Path": "/core/module/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE" ]
        },
        "Transforms": [{"PathPattern": "api/core/module/{**catch-all}"}]
      },
      "HRMProCluster": {
        "ClusterId": "HRMPro",
        //"AuthorizationPolicy": "default",
        "Match": {
          "Path": "/HRM/Profile/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE" ]
        },
        "Transforms": [{"PathPattern": "api/HRM/Profile/{**catch-all}"}]
      }
    },
    "Clusters": {
      "Lup": {
        "Destinations": {
          "lupApi": {
            "Address": "https://localhost:1100"
          }
        }
      },
      "coreHRMM": {
        "Destinations": {
          "coreHRMMApi": {
            "Address": "https://localhost:1101"
          }
        }
      },
      "CoreModule": {
        "Destinations": {
          "coreModuleApi": {
            "Address": "https://localhost:1214"
          }
        }
      },
      "HRMPro": {
        "Destinations": {
          "HRMProApi": {
            "Address": "https://localhost:1215"
          }
        }
      }
    }
  }
}