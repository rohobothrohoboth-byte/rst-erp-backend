+                  <Button size="sm" onClick={() => approveMut.mutate({ id: o.id, rowVersion: o.rowVersion })}>Approve</Button>
+                  <Button size="sm" variant="outline" onClick={() => acceptMut.mutate({ id: o.id, rowVersion: o.rowVersion })}>Accept</Button>
