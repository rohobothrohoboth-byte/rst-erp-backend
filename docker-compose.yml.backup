version: "3.8"

services:
  # ============================================================
  # POSTGRESQL - Single Database with Multiple Schemas
  # ============================================================

  postgres:
    image: postgres:16-alpine
    container_name: postgres
    restart: always
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-root}
      POSTGRES_DB: postgres
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./docker/postgres/init:/docker-entrypoint-initdb.d
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d postgres"]
      interval: 10s
      timeout: 5s
      retries: 10

  # ============================================================
  # RABBITMQ
  # ============================================================

  rabbitmq:
    image: rabbitmq:3-management
    container_name: rabbitmq
    restart: always
    environment:
      RABBITMQ_DEFAULT_USER: ${RABBITMQ_USER:-guest}
      RABBITMQ_DEFAULT_PASS: ${RABBITMQ_PASSWORD:-guest}
    ports:
      - "5672:5672"
      - "15672:15672"
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10

  # ============================================================
  # REDIS
  # ============================================================

  redis:
    image: redis:8.6
    container_name: redis
    restart: always
    command:
      [
        "redis-server",
        "--requirepass",
        "${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way}"
      ]
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10

  # ============================================================
  # AUTH SERVICE
  # ============================================================

  auth:
    build:
      context: .
      dockerfile: src/Svc.Auth/Dockerfile
    container_name: auth
    restart: unless-stopped
    ports:
      - "7000:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ConnectionStrings__authMgrCon: >-
        Host=postgres;Port=5432;Database=Auth.Mgr;
        Username=${POSTGRES_USER:-postgres};Password=${POSTGRES_PASSWORD:-root}
      ConnectionStrings__Redis: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Port: 5672
      RabbitMQ__Username: ${RABBITMQ_USER:-guest}
      RabbitMQ__Password: ${RABBITMQ_PASSWORD:-guest}
      ServiceUrls__CoreModuleApi: http://core-module
      ServiceUrls__CoreHRMMApi: http://core-hrmm
      ServiceUrls__HRMProApi: http://hrm-profile

  # ============================================================
  # CORE MODULE
  # ============================================================

  core-module:
    build:
      context: .
      dockerfile: src/Svc.Core/Cor.Module/Dockerfile
    container_name: core_module
    restart: unless-stopped
    ports:
      - "7002:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ConnectionStrings__CorModuleDbCon: >-
        Host=postgres;Port=5432;Database=core.Module;
        Username=${POSTGRES_USER:-postgres};Password=${POSTGRES_PASSWORD:-root}
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Port: 5672
      RabbitMQ__Username: ${RABBITMQ_USER:-guest}
      RabbitMQ__Password: ${RABBITMQ_PASSWORD:-guest}
      Backup__RootPath: /app/backups
    volumes:
      - core_backup_data:/app/backups

  # ============================================================
  # CORE HRMM
  # ============================================================

  core-hrmm:
    build:
      context: .
      dockerfile: src/Svc.Core/Cor.HRMM/Dockerfile
    container_name: core_hrmm
    restart: unless-stopped
    ports:
      - "7001:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ConnectionStrings__coreHRMMDbCon: >-
        Host=postgres;Port=5432;Database=core.HRMM;
        Username=${POSTGRES_USER:-postgres};Password=${POSTGRES_PASSWORD:-root}
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Port: 5672
      RabbitMQ__Username: ${RABBITMQ_USER:-guest}
      RabbitMQ__Password: ${RABBITMQ_PASSWORD:-guest}

  # ============================================================
  # HRM PROFILE
  # ============================================================

  hrm-profile:
    build:
      context: .
      dockerfile: src/Svc.HRM/HRM.Profile/Profile.API/Dockerfile
    container_name: hrm_profile
    restart: unless-stopped
    ports:
      - "7004:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ConnectionStrings__HRMProDbCon: >-
        Host=postgres;Port=5432;Database=HRM.Pro;
        Username=${POSTGRES_USER:-postgres};Password=${POSTGRES_PASSWORD:-root}
      ConnectionStrings__Redis: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false
      RabbitMQ__Host: rabbitmq

  # ============================================================
  # HRM LEAVE
  # ============================================================

  leave:
    build:
      context: .
      dockerfile: src/Svc.HRM/HRM.Leave/Leave.API/Dockerfile
    container_name: leave
    restart: unless-stopped
    ports:
      - "7003:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      RabbitMQ__Host: rabbitmq

  # ============================================================
  # HRM RECRUIT
  # ============================================================

  recruit:
    build:
      context: .
      dockerfile: src/Svc.HRM/HRM.Recruit/Recruit.API/Dockerfile
    container_name: recruit
    restart: unless-stopped
    ports:
      - "7005:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      RabbitMQ__Host: rabbitmq

  # ============================================================
  # TASK SERVICE
  # ============================================================

  task:
    build:
      context: .
      dockerfile: src/Svc.Task.Host/Dockerfile
    container_name: task
    restart: unless-stopped
    ports:
      - "7006:80"
    depends_on:
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # NOTIFICATION SERVICE
  # ============================================================

  notification:
    build:
      context: .
      dockerfile: src/Svc.Notification.Host/Dockerfile
    container_name: notification
    restart: unless-stopped
    ports:
      - "7007:80"
    depends_on:
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # FINANCE
  # ============================================================

  finance:
    build:
      context: .
      dockerfile: src/Svc.Finance/Cor.Finance/Dockerfile
    container_name: finance
    restart: unless-stopped
    ports:
      - "7008:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ConnectionStrings__coreFinanceDbCon: >-
        Host=postgres;Port=5432;Database=core.FinanceDbCon;
        Username=${POSTGRES_USER:-postgres};Password=${POSTGRES_PASSWORD:-root}
      ConnectionStrings__WarehouseDbCon: >-
        Host=postgres;Port=5432;Database=core.FinanceWarehouse;
        Username=${POSTGRES_USER:-postgres};Password=${POSTGRES_PASSWORD:-root}
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false
      RabbitMQ__Host: rabbitmq
      RabbitMQ__Port: 5672
      RabbitMQ__Username: ${RABBITMQ_USER:-guest}
      RabbitMQ__Password: ${RABBITMQ_PASSWORD:-guest}

  # ============================================================
  # FILE MANAGEMENT
  # ============================================================

  filemanagement:
    build:
      context: .
      dockerfile: src/Svc.FileManagement/Cor.FileManagement/Dockerfile
    container_name: filemanagement
    restart: unless-stopped
    ports:
      - "7009:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # PAYROLL
  # ============================================================

  payroll:
    build:
      context: .
      dockerfile: src/Svc.HRM/Svc.HRM.Payroll/Dockerfile
    container_name: payroll
    restart: unless-stopped
    ports:
      - "7010:80"
    depends_on:
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # ATTENDANCE
  # ============================================================

  attendance:
    build:
      context: .
      dockerfile: src/Svc.HRM/Svc.HRM.Attendance/Dockerfile
    container_name: attendance
    restart: unless-stopped
    ports:
      - "7011:80"
    depends_on:
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # TRAINING
  # ============================================================

  training:
    build:
      context: .
      dockerfile: src/Svc.HRM/Svc.HRM.Training/Dockerfile
    container_name: training
    restart: unless-stopped
    ports:
      - "5007:80"
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production

  # ============================================================
  # PERFORMANCE
  # ============================================================

  performance:
    build:
      context: .
      dockerfile: src/Svc.HRM/Svc.HRM.Performance/Dockerfile
    container_name: performance
    restart: unless-stopped
    ports:
      - "5005:80"
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production

  # ============================================================
  # CRM
  # ============================================================

  crm:
    build:
      context: .
      dockerfile: src/Svc.Core/Cor.CRM/Dockerfile
    container_name: crm
    restart: unless-stopped
    ports:
      - "7012:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # PROCUREMENT
  # ============================================================

  procurement:
    build:
      context: .
      dockerfile: src/Svc.Procurement/Cor.Procurement/Dockerfile
    container_name: procurement
    restart: unless-stopped
    ports:
      - "7013:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      AuthUrl: http://auth
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # INVENTORY
  # ============================================================

  inventory:
    build:
      context: .
      dockerfile: src/Svc.Inventory/Cor.Inventory/Dockerfile
    container_name: inventory
    restart: unless-stopped
    ports:
      - "7014:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      AuthUrl: http://auth
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # PLAN & DEVELOPMENT
  # ============================================================

  plandev:
    build:
      context: .
      dockerfile: src/Svc.Core/Cor.PlanDev/Dockerfile
    container_name: plandev
    restart: unless-stopped
    ports:
      - "7015:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      AuthUrl: http://auth
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # PROJECT MANAGEMENT ✅ (ADDED)
  # ============================================================

  projectmanagement:
    build:
      context: .
      dockerfile: src/Svc.ProjectManagement/Cor.ProjectManagement/Dockerfile
    container_name: projectmanagement
    restart: unless-stopped
    ports:
      - "7016:80"
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      redis:
        condition: service_healthy
      auth:
        condition: service_started
      finance:
        condition: service_started
      core-module:
        condition: service_started
      core-hrmm:
        condition: service_started
      crm:
        condition: service_started
      inventory:
        condition: service_started
      procurement:
        condition: service_started
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      AuthUrl: http://auth
      FinanceApiUrl: http://finance
      CoreApiUrl: http://core-module
      HrmApiUrl: http://core-hrmm
      CrmApiUrl: http://crm
      InventoryApiUrl: http://inventory
      ProcurementApiUrl: http://procurement
      RabbitMQ__Host: rabbitmq
      Redis__ConnectionString: >-
        redis:6379,password=${REDIS_PASSWORD:-kRrwYqqHWnnZpMhnn30way},abortConnect=false

  # ============================================================
  # API GATEWAY
  # ============================================================

  gateway:
    build:
      context: .
      dockerfile: src/Svc.Gateway/Dockerfile
    container_name: gateway
    restart: unless-stopped
    ports:
      - "5000:80"
    depends_on:
      auth:
        condition: service_started
      core-module:
        condition: service_started
      core-hrmm:
        condition: service_started
      finance:
        condition: service_started
      crm:
        condition: service_started
      inventory:
        condition: service_started
      procurement:
        condition: service_started
      projectmanagement:
        condition: service_started
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ServiceUrls__AuthApi: http://auth
      ServiceUrls__CoreModuleApi: http://core-module
      ServiceUrls__CoreHRMMApi: http://core-hrmm
      ServiceUrls__FinanceApi: http://finance
      ServiceUrls__CrmApi: http://crm
      ServiceUrls__InventoryApi: http://inventory
      ServiceUrls__ProcurementApi: http://procurement
      ServiceUrls__ProjectManagementApi: http://projectmanagement

# ==============================================================
# VOLUMES
# ==============================================================

volumes:
  postgres_data:
    name: rst_erp_postgres_data
  rabbitmq_data:
    name: rst_erp_rabbitmq_data
  redis_data:
    name: rst_erp_redis_data
  core_backup_data:
    name: rst_erp_core_backup_data


